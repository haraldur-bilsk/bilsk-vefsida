# Afrita þessa skrá í ".env" og fylla inn raunveruleg gildi.
# ALDREI setja .env inn í git eða deila því opinberlega - APIKEY er leynilegt.

# Fæst þegar Henry/Rögg hefur samþykkt umsókn (þarf fasta IP-tölu netþjónsins fyrst)
HENRY_API_URL=https://api.henry.rogg.is/xml-feed-url-hér
HENRY_API_KEY=set-inn-apikey-hér

# Auðkenni Bílskúrsins hjá Henry (ef API-ið krefst þess - staðfesta í skjalinu)
HENRY_DEALER_ID=

PORT=3000

# Hversu lengi (í sekúndum) á að geyma svar í minni áður en sótt er aftur.
# Henry mælir með beinni/rauntíma tengingu - 0 = engin skyndiminni, sækir í hvert sinn.
# Lágt gildi (t.d. 30) er samt skynsamlegt sem vörn gegn álagstoppum.
CACHE_TTL_SECONDS=30

# Sending tölvupósts fyrir fyrirspurnir/bókanir/sölu/innflutning (kemur í stað
# mailto:-krækjanna). Notar Gmail/Google Workspace SMTP með "App Password"
# (þarf 2-þátta staðfestingu virka á Google-reikningnum - sjá backend/README.md).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=bilskurinn@bilsk.is
EMAIL_APP_PASSWORD=set-inn-app-password-hér
# Hvert erindin eiga að berast (má sleppa - þá er notast við EMAIL_USER að ofan)
EMAIL_TO=bilskurinn@bilsk.is
# Netfangið sem birtist sem sendandi (má vera annað en EMAIL_USER að ofan).
# Þarf að vera stillt sem "Send As" samnefni undir EMAIL_USER-reikningnum í
# Gmail-stillingum, annars hafnar Gmail sendingunni - sjá backend/README.md.
# ATH: sendandinn birtist samt sem "me" í Gmail-innhólfinu sjálfu, sama hvað er
# stillt hér - það er ásættanlegt fyrir þennan vef (sjá athugasemd í README.md).
EMAIL_FROM=fyrirspurnir@bilsk.is
